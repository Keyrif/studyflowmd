# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL (used by the db container and by Django)
POSTGRES_DB=studyflowdb
POSTGRES_USER=studyflow
POSTGRES_PASSWORD=change-me

# Django
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# true only on your own computer; leave false anywhere public
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Browser push notifications (optional; leave empty to turn them off)
# Generate a pair with the py_vapid package; the private key never leaves the server.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
